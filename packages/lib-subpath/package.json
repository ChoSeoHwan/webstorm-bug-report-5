{
  "name": "@repro/lib-subpath",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "typings": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
